---
import CommandPalette from "./CommandPalette.astro";
import MascotSlot from "./MascotSlot.astro";
import { CAL_EVENT_URL } from "../consts";
const path = Astro.url.pathname;
const nav = [
  {
    number: "01",
    label: "services",
    href: "/services",
    active: path.startsWith("/services"),
  },
  {
    number: "02",
    label: "how it works",
    href: "/#how-it-works",
    active: false,
  },
  {
    number: "03",
    label: "track record",
    href: "/track-record",
    active: path.startsWith("/track-record"),
  },
  {
    number: "04",
    label: "writing",
    href: "/writing",
    active:
      path.startsWith("/writing") ||
      path.startsWith("/blog") ||
      path.startsWith("/tags"),
  },
];
---

<a class="skip-link" href="#main-content">
  Skip to content
</a>
<header class="site-header">
  <nav class="container" aria-label="Primary">
    <a class="logo" href="/" aria-label="Josh Robinson home">
      <span class="nav-avatar" aria-hidden="true">
        <MascotSlot
          slotId="S01"
          pose="head, front"
          src="/hexorx/hexorx-S01-head.webp"
          assetWidth={96}
          assetHeight={96}
          desktopWidth={34}
          desktopHeight={34}
          mobileWidth={34}
          mobileHeight={34}
          hex
          compact
        />
      </span>
      josh<span>@</span>robinson<span>:~</span>
    </a>
    <ul>
      {nav.map((item) => (
        <li>
          <a href={item.href} aria-current={item.active ? "page" : undefined}>
            <span class="number" aria-hidden="true">
              {item.number}
            </span>
            {item.label}
          </a>
        </li>
      ))}
    </ul>
    <button
      class="command-trigger"
      data-command-open
      aria-haspopup="dialog"
      aria-controls="command-palette"
    >
      <span class="search-label">Search or jump to…</span>
      <span class="mobile-label">Search</span>
      <kbd>⌘</kbd>
      <kbd>K</kbd>
    </button>
    <a class="button primary contact" href={CAL_EVENT_URL}>
      Book a call
    </a>
  </nav>
</header>
<CommandPalette />
<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(10, 12, 15, 0.8);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  nav {
    display: flex;
    align-items: center;
    gap: 28px;
    min-height: 60px;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 0;
    font: 600 15px var(--mono);
    text-decoration: none;
    white-space: nowrap;
  }
  .nav-avatar {
    flex: 0 0 34px;
    margin-right: 10px;
  }
  .logo span {
    color: var(--dim);
  }
  ul {
    display: flex;
    gap: 4px;
    list-style: none;
    padding: 0;
    margin: 0 0 0 12px;
  }
  ul a {
    display: flex;
    align-items: center;
    min-height: 40px;
    padding: 6px 10px;
    border-radius: 6px;
    font: 500 13px var(--mono);
    color: var(--mute);
    text-decoration: none;
  }
  ul a[aria-current] {
    background: var(--raised);
    color: var(--ink);
  }
  .number {
    color: var(--dim);
    margin-right: 6px;
  }
  .command-trigger {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 8px;
    font: 13px var(--mono);
    color: var(--mute);
    white-space: nowrap;
  }
  .mobile-label {
    display: none;
  }
  @media (max-width: 1050px) {
    nav {
      gap: 12px;
    }
    .search-label {
      display: none;
    }
    .mobile-label {
      display: inline;
    }
    ul {
      margin: 0;
    }
  }
  @media (max-width: 720px) {
    nav {
      flex-wrap: wrap;
      padding-block: 10px;
      gap: 8px;
    }
    .logo {
      font-size: 13px;
    }
    .command-trigger {
      padding: 6px 8px;
    }
    .command-trigger kbd {
      display: none;
    }
    ul {
      order: 3;
      flex: 1 1 100%;
      justify-content: space-between;
    }
    ul a {
      font-size: 11px;
      padding-inline: 4px;
    }
    .number {
      margin-right: 4px;
    }
    .contact {
      order: 4;
      font-size: 12px;
      padding-inline: 10px;
    }
  }
  @media print {
    .site-header {
      display: none;
    }
  }
</style>
