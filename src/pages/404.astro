---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import mascot from '../assets/hexorx/hexorx-404-hex-460.webp';
import '@fontsource/geist/latin-400.css';
import '@fontsource/geist/latin-700.css';
import '@fontsource/jetbrains-mono/latin-400.css';
---
<html lang="en">
  <head>
    <BaseHead title="404 — Josh Robinson" description="This page doesn't exist, or it moved." />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <main>
      <Image src={mascot} width={460} height={460} alt="hexorx, Josh Robinson's illustrated mascot, looking surprised" />
      <section aria-labelledby="error-title">
        <p class="kicker">404 / path not found</p>
        <div class="terminal">
          <p class="command">$ cd ./this-page</p>
          <p>zsh: no such file or directory</p>
        </div>
        <h1 id="error-title">This page doesn't exist, or it moved.</h1>
        <a href="/">Back home ↵</a>
      </section>
    </main>
  </body>
</html>
<style>
  body { background: var(--bg, #0A0C0F); color: var(--ink, #E8EDF2); font-family: Geist, sans-serif; }
  main { width: min(1200px, calc(100% - 64px)); max-width: none; min-height: 100svh; padding: 48px 0; box-sizing: border-box; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
  img { width: 100%; max-width: 460px; justify-self: center; }
  .kicker, .terminal, a { font-family: 'JetBrains Mono', monospace; }
  .kicker { font-size: 14px; color: var(--mute, #9AA6B2); }
  .terminal { padding: 24px; border: 1px solid var(--line, #26303A); border-radius: 8px; background: var(--surface, #11151A); font-size: 16px; overflow-wrap: anywhere; }
  .terminal p { margin: 0; }
  .command { color: var(--acc, #C6F432); }
  h1 { margin: 24px 0; color: inherit; font-size: clamp(28px, 4vw, 44px); line-height: 1.2; }
  a { display: inline-flex; min-height: 44px; align-items: center; padding: 0 20px; border-radius: 6px; background: var(--acc, #C6F432); color: #0A0C0F; font-size: 15px; text-decoration: none; }
  a:hover { color: #0A0C0F; text-decoration: underline; }
  a:focus-visible { outline: 2px solid var(--ink, #E8EDF2); outline-offset: 4px; }
  @media (max-width: 700px) { main { width: calc(100% - 40px); grid-template-columns: 1fr; gap: 24px; padding: 32px 0; } img { max-width: 260px; } }
</style>
