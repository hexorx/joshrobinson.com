---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Button from "../components/Button.astro";
import Kbd from "../components/Kbd.astro";
import MascotSlot from "../components/MascotSlot.astro";
import { personJsonLd, resume } from "../lib/resume";
const pending = (text: string) => text.includes("[Placeholder]");
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Resume | ${resume.name}`}
      description={resume.headline}
      jsonLd={personJsonLd(resume)}
    />
  </head>
  <body>
    <Header />
    <main id="main-content">
      <article class="resume">
        <header class="resume-header hairline-grid">
          <p class="kicker">Resume / CV</p>
          <h1>{resume.name}</h1>
          <p class="target placeholder">{resume.targetRole}</p>
          <p class="lede">{resume.headline}</p>
          <p class="meta">
            {resume.location} ·{" "}
            <a href={`mailto:${resume.email}`}>{resume.email}</a>
          </p>
          <ul class="profiles">
            {resume.profiles.map((profile) => (
              <li>
                <a href={profile.url}>{profile.network}</a>
              </li>
            ))}
          </ul>
          <div class="actions no-print">
            <button class="button primary" id="download-pdf" type="button">
              Download PDF
            </button>
            <Button href={`mailto:${resume.email}`}>Contact</Button>
          </div>
          <p class="pdf-note muted no-print">
            Download PDF opens print; choose Save as PDF.
          </p>
        </header>
        <p class="summary placeholder">{resume.summary}</p>
        <div class="resume-columns">
          <section class="career panel" aria-labelledby="career-title">
            <div class="career-heading">
              <h2 id="career-title">
                <span aria-hidden="true">$ </span>git log --career
              </h2>
              <div class="no-print">
                <MascotSlot
                  slotId="S07"
                  pose="walking forward, purposeful"
                  src="/hexorx/hexorx-S07-walk.webp"
                  assetWidth={600}
                  assetHeight={760}
                  desktopWidth={150}
                  desktopHeight={190}
                  mobileWidth={110}
                  mobileHeight={150}
                  bottomAligned
                />
              </div>
            </div>
            <ol class="career-log">
              {resume.experience.map((job) => (
                <li class:list={["entry", { current: job.current }]}>
                  <span class="node" aria-hidden="true"></span>
                  <span class="ref">
                    {job.ref}
                    <span class="sr-only">
                      {" "}
                      · {job.current ? "Current role" : "Past role"}
                    </span>
                  </span>
                  <div class="job">
                    <h3>
                      <span class:list={[{ placeholder: pending(job.role) }]}>
                        {job.role}
                      </span>{" "}
                      · {job.company}
                    </h3>
                    <p class="dates">
                      <span class:list={[{ placeholder: pending(job.start) }]}>
                        {job.start}
                      </span>{" "}
                      –{" "}
                      <span class:list={[{ placeholder: pending(job.end) }]}>
                        {job.end}
                      </span>
                    </p>
                    <ul>
                      {job.highlights.map((text) => (
                        <li>
                          <span class:list={[{ placeholder: pending(text) }]}>
                            {text}
                          </span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </li>
              ))}
            </ol>
          </section>
          <aside aria-label="Career details">
            <section aria-labelledby="skills-title">
              <h2 id="skills-title">Skills</h2>
              {resume.skills.map((group) => (
                <div class="skill-group">
                  <h3 class:list={[{ placeholder: pending(group.group) }]}>
                    {group.group}
                  </h3>
                  <div class="chips">
                    {group.items.map((item) => (
                      <span class:list={[{ placeholder: pending(item) }]}>
                        <Kbd>{item}</Kbd>
                      </span>
                    ))}
                  </div>
                </div>
              ))}
            </section>
            <section aria-labelledby="artifacts-title">
              <h2 id="artifacts-title">Artifacts</h2>
              <ul class="details">
                {resume.projects.map((project) => (
                  <li>
                    <h3>
                      {project.url ? (
                        <a href={project.url}>{project.name}</a>
                      ) : (
                        project.name
                      )}
                    </h3>
                    <p>{project.description}</p>
                  </li>
                ))}
              </ul>
            </section>
            <section aria-labelledby="community-title">
              <h2 id="community-title">Community</h2>
              <ul class="details">
                {resume.community.map((text) => (
                  <li>{text}</li>
                ))}
              </ul>
            </section>
            <section aria-labelledby="education-title">
              <h2 id="education-title">Education</h2>
              <ul class="details">
                {resume.education.map((item) => (
                  <li>
                    <h3>
                      {item.credential} · {item.school}
                    </h3>
                    <p class="meta">{item.year}</p>
                  </li>
                ))}
              </ul>
            </section>
          </aside>
        </div>
      </article>
    </main>
    <Footer />
    <script>
      document
        .querySelector("#download-pdf")
        ?.addEventListener("click", () => window.print());
    </script>
  </body>
</html>
<style>
  .resume-header {
    padding-block: 20px 32px;
  }
  .target {
    display: inline-block;
    font: 12px var(--mono);
    margin-bottom: 20px;
  }
  .meta,
  .dates,
  .profiles {
    font: 12px/1.6 var(--mono);
    color: var(--mute);
  }
  .profiles {
    display: flex;
    gap: 20px;
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
  }
  .pdf-note {
    font-size: 12px;
    margin: 8px 0 0;
  }
  .summary {
    margin-bottom: 32px;
  }
  .resume-columns {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: 32px;
    align-items: start;
  }
  .resume section {
    margin-top: 0;
  }
  .career-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 20px;
    background: var(--raised);
    border-bottom: 1px solid var(--line);
  }
  .career-heading h2 {
    font: 14px/1.6 var(--mono);
    letter-spacing: 0;
    margin: 0;
  }
  .career-heading h2 span {
    color: var(--acc);
  }
  .career-log {
    list-style: none;
    margin: 0;
    padding: 12px 0;
  }
  .entry {
    display: grid;
    grid-template-columns: 18px 62px minmax(0, 1fr);
    gap: 12px;
    padding: 20px;
    position: relative;
  }
  .entry:before {
    content: "";
    position: absolute;
    left: 28px;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--line-2);
  }
  .entry:first-child:before {
    top: 27px;
  }
  .entry:last-child:before {
    bottom: calc(100% - 27px);
  }
  .node {
    position: relative;
    width: 10px;
    height: 10px;
    margin: 6px 0 0 4px;
    border: 2px solid var(--dim);
    border-radius: 50%;
    background: var(--surface);
  }
  .current .node {
    background: var(--acc);
    border-color: var(--acc);
  }
  .ref {
    color: var(--amber);
    font: 12px/1.8 var(--mono);
  }
  .job h3 {
    font-size: 17px;
    line-height: 1.6;
    margin: 0 0 8px;
  }
  .dates {
    margin: 0 0 12px;
  }
  .job ul {
    padding-left: 18px;
    margin: 0;
    color: var(--mute);
    font-size: 14px;
  }
  .job li + li {
    margin-top: 8px;
  }
  aside {
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--surface);
  }
  aside section + section {
    margin-top: 32px !important;
  }
  aside h2 {
    font: 14px var(--mono);
    letter-spacing: 0;
    color: var(--mute);
    margin-bottom: 20px;
  }
  aside h3 {
    font-size: 15px;
    line-height: 1.6;
    margin: 0 0 8px;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .details {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 14px;
  }
  .details li + li {
    margin-top: 20px;
  }
  .details p {
    margin: 0;
    color: var(--mute);
  }
  @media (max-width: 720px) {
    .resume-columns {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .career-heading {
      padding: 16px;
    }
    .career-heading h2 {
      font-size: 12px;
    }
    .entry {
      grid-template-columns: 18px minmax(0, 1fr);
      gap: 8px;
      padding: 16px;
    }
    .entry:before {
      left: 24px;
    }
    .job {
      grid-column: 2;
    }
    .node {
      grid-row: 1 / 3;
    }
  }
  @media print {
    @page {
      size: A4;
      margin: 12mm;
    }
    :global(.site-header),
    :global(footer),
    :global(dialog),
    :global(.command-status),
    .no-print {
      display: none !important;
    }
    :global(main) {
      max-width: none;
      padding: 0;
      min-height: 0;
    }
    :global(body) {
      font-size: 10pt;
      line-height: 1.35;
    }
    .resume-header {
      padding: 0 0 12px;
    }
    h1 {
      font-size: 28pt;
      margin-bottom: 12px;
    }
    .lede {
      font-size: 12pt;
      margin-bottom: 10px;
    }
    .target,
    .meta,
    .profiles {
      margin-bottom: 8px;
    }
    .summary {
      margin-bottom: 12px;
    }
    .resume-columns {
      display: grid;
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      gap: 16px;
    }
    .career {
      overflow: visible;
    }
    .career-heading {
      padding: 10px;
    }
    .career-log {
      padding: 0;
    }
    .entry {
      grid-template-columns: 12px 42px minmax(0, 1fr);
      gap: 6px;
      padding: 12px 10px;
      break-inside: avoid;
    }
    .entry:before {
      left: 14px;
    }
    .node {
      margin-left: 0;
      border-color: black;
      grid-row: auto;
    }
    .current .node {
      border-width: 5px;
      background: black;
      border-color: black;
    }
    .ref {
      color: black;
      font-size: 8pt;
    }
    .job {
      grid-column: auto;
    }
    .job h3 {
      font-size: 10pt;
      margin-bottom: 6px;
    }
    .job ul {
      font-size: 9pt;
    }
    .job li + li {
      margin-top: 4px;
    }
    .dates {
      font-size: 8pt;
      margin-bottom: 6px;
    }
    aside {
      padding: 12px;
    }
    aside section {
      break-inside: avoid;
    }
    aside section + section {
      margin-top: 20px !important;
    }
    aside h2,
    aside h3 {
      font-size: 10pt;
      margin-bottom: 8px;
    }
    .details {
      font-size: 9pt;
    }
    .placeholder {
      color: black;
      padding: 1px 3px;
    }
  }
</style>
