{
  "name": "joshrobinson-com",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "check:links": "node scripts/check-links.mjs",
    "test": "npm run test:hosting && npm run test:unit && npm run test:build && playwright test",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "format:check": "prettier --plugin prettier-plugin-astro --check \"src/**/*.{astro,css,ts}\" \"tests/**/*.ts\" \"*.{mjs,ts}\" \".github/workflows/*.yml\"",
    "test:hosting": "node --test tests/check-links.test.mjs tests/preview-gate.test.mjs",
    "test:unit": "node --test tests/social-card.test.mjs",
    "test:build": "node --test tests/built-kit.test.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5",
    "sharp": "^0.35.0",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "satori": "0.32.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  },
  "description": "Josh Robinson's personal site, blog, and online resume.",
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "cheerio": "^1.2.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.147.0",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0"
  },
  "overrides": {
    "satori": {
      "fflate": "^0.8.3"
    }
  }
}
