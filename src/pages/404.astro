---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Terminal from "../components/Terminal.astro";
import Button from "../components/Button.astro";
import MascotSlot from "../components/MascotSlot.astro";
import { CAL_EVENT_URL } from "../consts";
---

<html lang="en">
  <head>
    <BaseHead
      title="Page not found · Josh Robinson"
      description="This page doesn't exist. Head back home, or book a call if you were looking for help with AI."
      canonical={false}
    />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <Header />
    <main id="main-content" tabindex="-1">
      <div class="mascot">
        <MascotSlot
          slotId="S08"
          pose="surprised shrug"
          src="/hexorx/hexorx-S08-404.webp"
          assetWidth={1200}
          assetHeight={1260}
          desktopWidth={420}
          desktopHeight={440}
          mobileWidth={300}
          mobileHeight={320}
          bottomAligned
          alt="Supplied surprised hexorx head; final S08 full-body art pending"
        />
      </div>
      <section aria-labelledby="error-title">
        <p class="kicker">$ cd ./this-page</p>
        <Terminal title="zsh — ./this-page">
          <span class="command">error: no such file or directory</span>
        </Terminal>
        <h1 id="error-title">That page doesn't exist.</h1>
        <p>It may have moved when I rebuilt the site.</p>
        <div class="actions">
          <Button href="/" primary>
            Go home
          </Button>
          <Button href="/services">See services</Button>
          <Button href={CAL_EVENT_URL}>Book a call</Button>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
<style>
  main {
    min-height: 65svh;
    display: grid;
    grid-template-columns: 420px 1fr;
    gap: 48px;
    align-items: center;
    padding-block: 48px;
  }
  .mascot {
    justify-self: center;
    max-width: 100%;
  }
  .command {
    color: var(--acc);
  }
  h1 {
    margin-block: 24px;
    font-size: clamp(28px, 4vw, 44px);
    line-height: 1.2;
  }
  @media (max-width: 900px) {
    main {
      grid-template-columns: 1fr;
      gap: 24px;
      padding-block: 32px;
    }
  }
</style>
