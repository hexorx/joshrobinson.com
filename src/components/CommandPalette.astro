---
import { getPublishedPosts } from "../lib/posts";
import { resume } from "../lib/resume";
const posts = await getPublishedPosts();
const pages = [
  { title: "Home", href: "/" },
  { title: "Selected work", href: "/#work" },
  { title: "Writing", href: "/blog/" },
  { title: "Resume", href: "/resume/" },
  { title: "About / contact", href: "/about/" },
  { title: "Tags", href: "/tags/" },
];
---

<dialog
  id="command-palette"
  aria-labelledby="command-title"
  aria-describedby="command-help"
  data-email={resume.email}
>
  <div class="palette-heading">
    <h2 id="command-title">Search or jump to…</h2>
    <button data-command-close aria-label="Close command palette">
      Esc
    </button>
  </div>
  <label for="command-search" class="sr-only">
    Search pages, posts and actions
  </label>
  <input
    id="command-search"
    type="search"
    placeholder="Type a page, post or action…"
    autocomplete="off"
  />
  <div class="command-results">
    <section data-command-group>
      <h3>Pages</h3>
      <ul>
        {pages.map((page) => (
          <li data-command-item>
            <a href={page.href}>
              {page.title}
              <span aria-hidden="true">↵</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
    <section data-command-group>
      <h3>Posts</h3>
      <ul>
        {posts.map((post) => (
          <li data-command-item>
            <a href={`/blog/${post.id}/`}>
              {post.data.title}
              <span aria-hidden="true">↵</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
    <section data-command-group>
      <h3>Actions</h3>
      <ul>
        <li data-command-item>
          <button data-copy-email>
            Copy email {resume.email ? "" : "[Placeholder]"}
            <span aria-hidden="true">⧉</span>
          </button>
        </li>
        <li data-command-item>
          <a href="/rss.xml">
            Open RSS<span aria-hidden="true">↗</span>
          </a>
        </li>
        <li data-command-item>
          <a href="/cv-placeholder.pdf" download>
            Download CV PDF [Placeholder]<span aria-hidden="true">↓</span>
          </a>
        </li>
      </ul>
    </section>
  </div>
  <p class="empty" hidden>
    No matching commands.
  </p>
  <p
    id="command-count"
    role="status"
    aria-live="polite"
    aria-atomic="true"
    class="sr-only"
  ></p>
  <p id="command-status" role="status" aria-live="polite" class="sr-only"></p>
  <p id="command-help">↑ ↓ move · Tab navigate · Enter select · Esc close</p>
</dialog>
<script>
  const dialog = document.querySelector<HTMLDialogElement>("#command-palette")!;
  const search = dialog.querySelector<HTMLInputElement>("#command-search")!;
  const status = dialog.querySelector<HTMLElement>("#command-status")!;
  const countStatus = dialog.querySelector<HTMLElement>("#command-count")!;
  let countTimer: ReturnType<typeof setTimeout> | undefined;
  const cancelCount = () => {
    clearTimeout(countTimer);
    countStatus.textContent = "";
  };
  let opener: HTMLElement | null = null;
  const items = Array.from(
    dialog.querySelectorAll<HTMLElement>("[data-command-item]"),
  );
  const controls = () =>
    Array.from(
      dialog.querySelectorAll<HTMLElement>("a[href], button, input"),
    ).filter((el) => !el.closest("[hidden]"));
  const results = () =>
    items
      .filter((item) => !item.hidden)
      .map((item) => item.querySelector<HTMLElement>("a,button")!);
  const filter = () => {
    const query = search.value.trim().toLocaleLowerCase();
    items.forEach((item) => {
      item.hidden = !item.textContent?.toLocaleLowerCase().includes(query);
    });
    dialog
      .querySelectorAll<HTMLElement>("[data-command-group]")
      .forEach((group) => {
        group.hidden = !group.querySelector(
          "[data-command-item]:not([hidden])",
        );
      });
    const count = results().length;
    dialog.querySelector<HTMLElement>(".empty")!.hidden = count !== 0;
    // Let key echo finish before the reader receives the final result count.
    // Clearing also lets the same count be announced for a different query.
    cancelCount();
    countTimer = setTimeout(() => {
      if (dialog.open) countStatus.textContent = `${count} matching commands.`;
    }, 500);
  };
  const open = () => {
    if (dialog.open) return;
    opener =
      document.activeElement instanceof HTMLElement
        ? document.activeElement
        : null;
    status.textContent = "";
    search.value = "";
    filter();
    dialog.showModal();
    search.focus();
  };
  document
    .querySelectorAll("[data-command-open]")
    .forEach((button) => button.addEventListener("click", open));
  dialog
    .querySelector("[data-command-close]")!
    .addEventListener("click", () => dialog.close());
  dialog.addEventListener("close", () => {
    cancelCount();
    opener?.focus();
  });
  document.addEventListener("keydown", (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
      event.preventDefault();
      dialog.open ? dialog.close() : open();
    }
  });
  search.addEventListener("input", filter);
  dialog.addEventListener("keydown", (event) => {
    if (event.key === "Tab") {
      const list = controls();
      const first = list[0];
      const last = list.at(-1);
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last?.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first?.focus();
      }
    }
    if (event.key === "ArrowDown" || event.key === "ArrowUp") {
      event.preventDefault();
      const list = results();
      const index = list.indexOf(document.activeElement as HTMLElement);
      const next =
        index === -1
          ? event.key === "ArrowDown"
            ? 0
            : list.length - 1
          : (index + (event.key === "ArrowDown" ? 1 : -1) + list.length) %
            list.length;
      list[next]?.focus();
    }
    if (event.key === "Enter" && document.activeElement === search) {
      event.preventDefault();
      results()[0]?.click();
    }
  });
  dialog
    .querySelectorAll("a")
    .forEach((link) => link.addEventListener("click", () => dialog.close()));
  dialog
    .querySelector("[data-copy-email]")!
    .addEventListener("click", async () => {
      cancelCount();
      if (!dialog.dataset.email) {
        status.textContent = "Email is awaiting Josh. See About / contact.";
        return;
      }
      try {
        await navigator.clipboard.writeText(dialog.dataset.email);
        status.textContent = "Email copied.";
      } catch {
        status.textContent = `Could not copy. Email: ${dialog.dataset.email}`;
      }
    });
</script>
<style>
  dialog {
    width: min(560px, calc(100% - 40px));
    max-height: 80dvh;
    padding: 0;
    border: 1px solid var(--line-2);
    border-radius: var(--r-lg);
    background: var(--surface);
    color: var(--ink);
    box-shadow: 0 24px 80px #0008;
  }
  dialog::backdrop {
    background: #0009;
    backdrop-filter: blur(4px);
  }
  .palette-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 20px;
    border-bottom: 1px solid var(--line);
  }
  h2 {
    font: 500 16px/1.6 var(--sans);
    margin: 0;
    letter-spacing: 0;
  }
  #command-search {
    display: block;
    width: calc(100% - 40px);
    margin: 16px 20px;
    min-height: 44px;
    font: 14px var(--mono);
  }
  .command-results {
    max-height: 45dvh;
    overflow: auto;
    padding: 0 12px 12px;
  }
  h3 {
    font: 500 12px/1.6 var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--mute);
    margin: 16px 8px 8px;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  li a,
  li button {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 44px;
    padding: 10px 12px;
    text-align: left;
    text-decoration: none;
    border: 0;
    border-radius: 6px;
    font: 14px var(--sans);
    background: transparent;
    color: var(--ink);
  }
  li a:hover,
  li button:hover,
  li a:focus-visible,
  li button:focus-visible {
    background: var(--raised);
  }
  li span {
    color: var(--dim);
  }
  [aria-disabled] {
    color: var(--mute);
  }
  #command-help {
    margin: 0;
    border-top: 1px solid var(--line);
    padding: 14px 20px;
    font: 11px var(--mono);
    color: var(--mute);
  }
  .empty {
    padding: 20px;
    color: var(--mute);
  }
  [hidden] {
    display: none !important;
  }
  @media print {
    dialog {
      display: none;
    }
  }
</style>
