---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Terminal from "../components/Terminal.astro";
import Button from "../components/Button.astro";
import Kicker from "../components/Kicker.astro";
import MascotSlot from "../components/MascotSlot.astro";
---

<html lang="en">
  <head>
    <BaseHead
      title="404 — Josh Robinson"
      description="This page doesn't exist, or it moved."
    />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <Header />
    <main id="main-content" tabindex="-1">
      <div class="mascot">
        <MascotSlot
          slotId="S08"
          pose="surprised shrug"
          src="/hexorx/hexorx-S08-404.webp"
          assetWidth={1200}
          assetHeight={1260}
          desktopWidth={420}
          desktopHeight={440}
          mobileWidth={300}
          mobileHeight={320}
          bottomAligned
          alt="Supplied surprised hexorx head; final S08 full-body art pending"
        />
      </div>
      <section aria-labelledby="error-title">
        <Kicker number="404">path not found</Kicker>
        <Terminal title="zsh — ./this-page">
          <span class="command">$ cd ./this-page</span>
          {"\n"}zsh: no such file or directory
        </Terminal>
        <h1 id="error-title">This page doesn't exist, or it moved.</h1>
        <Button href="/" primary>
          Back home ↵
        </Button>
      </section>
    </main>
    <Footer />
  </body>
</html>
<style>
  main {
    min-height: 65svh;
    display: grid;
    grid-template-columns: 420px 1fr;
    gap: 48px;
    align-items: center;
    padding-block: 48px;
  }
  .mascot {
    justify-self: center;
    max-width: 100%;
  }
  .command {
    color: var(--acc);
  }
  h1 {
    margin-block: 24px;
    font-size: clamp(28px, 4vw, 44px);
    line-height: 1.2;
  }
  @media (max-width: 900px) {
    main {
      grid-template-columns: 1fr;
      gap: 24px;
      padding-block: 32px;
    }
  }
</style>
