---
import type { Post } from "../lib/posts";
import { readingMinutes, isoDate, postLink } from "../lib/writing";
import TagList from "./TagList.astro";
interface Props {
  posts: Post[];
}
const { posts } = Astro.props;
---

<ul class="writing-rows">
  {posts.map((post) => (
    <li>
      <time datetime={post.data.pubDate.toISOString()}>
        {isoDate(post.data.pubDate)}
      </time>
      <a class="post-title" href={postLink(post)}>
        {post.data.draft && "[Draft] "}
        {post.data.title}
      </a>
      <TagList tags={post.data.tags} />
      <span class="read-time">
        {readingMinutes(post.body)} min<span class="sr-only"> read</span>
      </span>
    </li>
  ))}
</ul>
<style>
  .writing-rows {
    list-style: none;
    padding: 0;
    margin: 24px 0;
  }
  li {
    display: grid;
    grid-template-columns: 110px minmax(0, 1fr) minmax(100px, 200px) 70px;
    gap: 20px;
    align-items: center;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }
  time,
  .read-time {
    font: 12px var(--mono);
    color: var(--mute);
  }
  .post-title {
    font-weight: 600;
    text-decoration: none;
  }
  .read-time {
    text-align: right;
  }
  @media (max-width: 720px) {
    li {
      grid-template-columns: 1fr auto;
      gap: 8px 16px;
    }
    .post-title {
      grid-column: 1/-1;
      grid-row: 2;
    }
    .read-time {
      grid-column: 2;
      grid-row: 1;
    }
  }
</style>
