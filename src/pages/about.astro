---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { Image } from 'astro:assets';
import portrait from '../assets/blog-placeholder-about.jpg';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>About</h1>
			<Image src={portrait} alt="Placeholder image" width={720} />
			<!-- PLACEHOLDER: replace with Josh's real bio and a real photo (src/assets/). -->
			<p>[Placeholder bio. A few paragraphs on background, interests, and how to get in touch.]</p>
		</main>
		<Footer />
	</body>
</html>
