---
import { CONTACT_EMAIL } from "../consts";
---

<footer class="container site-footer">
  <div>
    <p>Josh Robinson · AI consulting for small and mid-sized businesses</p>
    <p>
      Newton, Iowa · In person across Des Moines and central Iowa · Remote
      anywhere · <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
    </p>
    <p class="credit">built with Astro, served by Cloudflare</p>
  </div>
  <nav aria-label="Social links">
    <a href="/services">Services</a>
    <a href="/track-record">Track record</a>
    <a href="/ai-for-realtors">AI for Realtors</a>
    <a href="/writing">Writing</a>
    <a href="https://linkedin.com/in/hexorx" rel="me">
      LinkedIn
    </a>
    <a href="https://github.com/hexorx" rel="me">
      GitHub
    </a>
    <a href="/rss.xml">RSS</a>
  </nav>
</footer>
<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding-block: 28px 48px;
    display: flex;
    justify-content: space-between;
    gap: 24px;
    font: 13px/1.6 var(--mono);
    color: var(--mute);
  }
  p {
    margin: 0;
  }
  nav {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
  }
  a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    text-decoration: none;
  }
  .credit {
    margin-top: 8px;
  }
  @media (max-width: 720px) {
    .site-footer {
      flex-direction: column;
    }
    nav {
      justify-content: flex-start;
      gap: 16px;
    }
  }
  @media print {
    .site-footer {
      display: none;
    }
  }
</style>
