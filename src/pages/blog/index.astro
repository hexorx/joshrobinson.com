---
import { Image } from "astro:assets";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import MascotSlot from "../../components/MascotSlot.astro";
import WritingRows from "../../components/WritingRows.astro";
import WritingNewsletter from "../../components/WritingNewsletter.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";
import { getPublishedPosts, getTags } from "../../lib/posts";
import { postLink, readingMinutes } from "../../lib/writing";
const posts = await getPublishedPosts();
const tags = await getTags();
const featured = posts[0];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Writing | ${SITE_TITLE}`}
      description={SITE_DESCRIPTION}
    />
  </head>
  <body>
    <Header />
    <main id="main-content" tabindex="-1">
      <div class="writing-hero hairline-grid">
        <div>
          <p class="kicker">02 / writing</p>
          <h1>Writing</h1>
          <p class="lede placeholder">
            [Placeholder] Josh’s introduction to the writing.
          </p>
        </div>
        <MascotSlot
          slotId="S05"
          pose="reading"
          src="/hexorx/hexorx-S05-existing.webp"
          assetWidth={880}
          assetHeight={880}
          desktopWidth={220}
          desktopHeight={220}
          mobileWidth={170}
          mobileHeight={170}
          alt="Existing hexorx kit crop; S05 reading art pending"
        />
      </div>
      <nav class="tag-filters" aria-label="Filter writing by tag">
        <a aria-current="page" href="/blog/">
          All posts
        </a>
        {tags.map(({ tag, count }) => (
          <a href={`/tags/${tag}/`}>
            #{tag} <span>({count})</span>
          </a>
        ))}
        <a href="/tags/">All tags ↗</a>
      </nav>
      {featured && (
        <section class="featured panel" aria-label="Featured post">
          <div class="featured-art hairline-grid">
            {featured.data.heroImage && (
              <Image
                src={featured.data.heroImage}
                width={720}
                height={360}
                alt=""
              />
            )}
          </div>
          <div class="panel-body">
            <p class="kicker">
              Featured / {readingMinutes(featured.body)} min read
            </p>
            <h2>
              <a href={postLink(featured)}>{featured.data.title}</a>
            </h2>
            <p class="muted">{featured.data.description}</p>
          </div>
        </section>
      )}
      <WritingRows posts={posts} />
      <WritingNewsletter />
    </main>
    <Footer />
  </body>
</html>
<style>
  .writing-hero {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
    padding-bottom: 32px;
  }
  .tag-filters {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin: 24px 0;
  }
  .tag-filters a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 8px 12px;
    border: 1px solid var(--line-2);
    border-radius: var(--r-sm);
    font: 12px var(--mono);
    text-decoration: none;
  }
  .tag-filters [aria-current] {
    border-color: var(--acc);
  }
  .featured {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .featured-art {
    background: radial-gradient(ellipse at center, #7aa2ff22, transparent 70%);
    min-height: 160px;
  }
  .featured-art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
  }
  @media (max-width: 720px) {
    .writing-hero {
      align-items: flex-start;
      flex-direction: column;
    }
    .featured {
      grid-template-columns: 1fr;
    }
  }
</style>
