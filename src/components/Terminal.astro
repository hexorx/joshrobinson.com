---
interface Props {
  title?: string;
  label?: string;
}
const { title = "zsh — ~/josh", label } = Astro.props;
---

<div class="terminal" role={label ? "img" : undefined} aria-label={label}>
  <div class="terminal-bar">
    <span aria-hidden="true">● ● ●</span> {title}
  </div>
  <pre aria-hidden={label ? "true" : undefined}><slot /></pre>
</div>
