---
import { CAL_EVENT_URL, CONTACT_EMAIL } from "../consts";
---

<dialog
  id="command-palette"
  aria-labelledby="command-title"
  aria-describedby="command-help"
  data-email={CONTACT_EMAIL}
>
  <div class="palette-heading">
    <h2 id="command-title">Search or jump to…</h2>
    <button data-command-close aria-label="Close command palette">
      Esc
    </button>
  </div>
  <label for="command-search" class="sr-only">
    Search pages, posts and actions
  </label>
  <input
    id="command-search"
    type="search"
    placeholder="Search or jump to…"
    autocomplete="off"
  />
  <div class="command-results">
    <section data-command-group>
      <h3>Get started</h3>
      <ul>
        <li data-command-item>
          <a href={CAL_EVENT_URL}>
            Book an intro call
            <span class="sr-only">
              book call meeting schedule talk hire contact
            </span>
            <span aria-hidden="true">↵</span>
          </a>
        </li>
        <li data-command-item>
          <a href={`mailto:${CONTACT_EMAIL}`}>
            Email Josh
            <span class="sr-only">email contact message hello</span>
            <span aria-hidden="true">↵</span>
          </a>
        </li>
        <li data-command-item>
          <button data-copy-email>
            Copy email address
            <span class="sr-only">copy email</span>
            <span aria-hidden="true">⌘C</span>
          </button>
        </li>
      </ul>
    </section>
    <section data-command-group>
      <h3>Services</h3>
      <ul>
        <li data-command-item>
          <a href="/services">
            All services
            <span class="sr-only">services help offer pricing</span>
            <span aria-hidden="true">/services</span>
          </a>
        </li>
        <li data-command-item>
          <a href="/services#explore">
            Explore: find where AI can help
            <span class="sr-only">
              assess assessment audit strategy plan where to start
            </span>
            <span aria-hidden="true">/services#explore</span>
          </a>
        </li>
        <li data-command-item>
          <a href="/services#set-up">
            Set up: build and connect AI
            <span class="sr-only">
              build agents integrate automation connect data tools
            </span>
            <span aria-hidden="true">/services#set-up</span>
          </a>
        </li>
        <li data-command-item>
          <a href="/services#train">
            Train: get your team using it
            <span class="sr-only">training workshop team adoption policy</span>
            <span aria-hidden="true">/services#train</span>
          </a>
        </li>
        <li data-command-item>
          <a href="/#how-it-works">
            How an engagement works
            <span class="sr-only">process steps how</span>
            <span aria-hidden="true">/#how-it-works</span>
          </a>
        </li>
      </ul>
    </section>
    <section data-command-group>
      <h3>Pages</h3>
      <ul>
        <li data-command-item>
          <a href="/">
            Home
            <span class="sr-only">home start</span>
            <span aria-hidden="true">/</span>
          </a>
        </li>
        <li data-command-item>
          <a href="/track-record">
            Track record
            <span class="sr-only">
              resume cv experience background career about
            </span>
            <span aria-hidden="true">/track-record</span>
          </a>
        </li>
        <li data-command-item>
          <a href="/ai-for-realtors">
            AI for Realtors
            <span class="sr-only">real estate realtor agent brokerage</span>
            <span aria-hidden="true">/ai-for-realtors</span>
          </a>
        </li>
        <li data-command-item>
          <a href="/#examples">
            Examples by industry
            <span class="sr-only">
              industries examples use cases logistics healthcare legal
              accounting construction
            </span>
            <span aria-hidden="true">/#examples</span>
          </a>
        </li>
        <li data-command-item>
          <a href="/#about">
            About Josh
            <span class="sr-only">about who bio</span>
            <span aria-hidden="true">/#about</span>
          </a>
        </li>
        <li data-command-item>
          <a href="/book">
            Booking page
            <span class="sr-only">calendar embed intro</span>
            <span aria-hidden="true">/book</span>
          </a>
        </li>
        <li data-command-item>
          <a href="/writing">
            Writing
            <span class="sr-only">blog posts articles notes</span>
            <span aria-hidden="true">/writing</span>
          </a>
        </li>
      </ul>
    </section>
    <section data-command-group>
      <h3>Elsewhere</h3>
      <ul>
        <li data-command-item>
          <a href="https://linkedin.com/in/hexorx" rel="me">
            LinkedIn<span aria-hidden="true">↗</span>
          </a>
        </li>
        <li data-command-item>
          <a href="https://github.com/hexorx" rel="me">
            GitHub<span aria-hidden="true">↗</span>
          </a>
        </li>
        <li data-command-item>
          <a href="/rss.xml">
            RSS feed<span aria-hidden="true">/rss.xml</span>
          </a>
        </li>
      </ul>
    </section>
  </div>
  <p class="empty" hidden>
    No matches. Try "services", "book a call", or "track record".
  </p>
  <p
    id="command-count"
    role="status"
    aria-live="polite"
    aria-atomic="true"
    class="sr-only"
  ></p>
  <p id="command-status" role="status" aria-live="polite" class="sr-only"></p>
  <p id="command-help">↑↓ to move · ↵ to open · esc to close</p>
</dialog>
<script>
  const dialog = document.querySelector<HTMLDialogElement>("#command-palette")!;
  const search = dialog.querySelector<HTMLInputElement>("#command-search")!;
  const status = dialog.querySelector<HTMLElement>("#command-status")!;
  const countStatus = dialog.querySelector<HTMLElement>("#command-count")!;
  let countTimer: ReturnType<typeof setTimeout> | undefined;
  const cancelCount = () => {
    clearTimeout(countTimer);
    countStatus.textContent = "";
  };
  let opener: HTMLElement | null = null;
  const items = Array.from(
    dialog.querySelectorAll<HTMLElement>("[data-command-item]"),
  );
  const controls = () =>
    Array.from(
      dialog.querySelectorAll<HTMLElement>("a[href], button, input"),
    ).filter((el) => !el.closest("[hidden]"));
  const results = () =>
    items
      .filter((item) => !item.hidden)
      .map((item) => item.querySelector<HTMLElement>("a,button")!);
  const filter = () => {
    const query = search.value.trim().toLocaleLowerCase();
    items.forEach((item) => {
      item.hidden = !item.textContent?.toLocaleLowerCase().includes(query);
    });
    dialog
      .querySelectorAll<HTMLElement>("[data-command-group]")
      .forEach((group) => {
        group.hidden = !group.querySelector(
          "[data-command-item]:not([hidden])",
        );
      });
    const count = results().length;
    dialog.querySelector<HTMLElement>(".empty")!.hidden = count !== 0;
    cancelCount();
    countTimer = setTimeout(() => {
      if (dialog.open) countStatus.textContent = `${count} matching commands.`;
    }, 500);
  };
  const open = () => {
    if (dialog.open) return;
    opener =
      document.activeElement instanceof HTMLElement
        ? document.activeElement
        : null;
    status.textContent = "";
    search.value = "";
    filter();
    dialog.showModal();
    search.focus();
  };
  document
    .querySelectorAll("[data-command-open]")
    .forEach((button) => button.addEventListener("click", open));
  dialog
    .querySelector("[data-command-close]")!
    .addEventListener("click", () => dialog.close());
  dialog.addEventListener("close", () => {
    cancelCount();
    opener?.focus();
  });
  document.addEventListener("keydown", (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
      event.preventDefault();
      dialog.open ? dialog.close() : open();
    }
  });
  search.addEventListener("input", filter);
  dialog.addEventListener("keydown", (event) => {
    if (event.key === "Tab") {
      const list = controls();
      const first = list[0];
      const last = list.at(-1);
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last?.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first?.focus();
      }
    }
    if (event.key === "ArrowDown" || event.key === "ArrowUp") {
      event.preventDefault();
      const list = results();
      const index = list.indexOf(document.activeElement as HTMLElement);
      const next =
        index === -1
          ? event.key === "ArrowDown"
            ? 0
            : list.length - 1
          : (index + (event.key === "ArrowDown" ? 1 : -1) + list.length) %
            list.length;
      list[next]?.focus();
    }
    if (event.key === "Enter" && document.activeElement === search) {
      event.preventDefault();
      results()[0]?.click();
    }
  });
  dialog
    .querySelectorAll("a")
    .forEach((link) => link.addEventListener("click", () => dialog.close()));
  dialog
    .querySelector("[data-copy-email]")!
    .addEventListener("click", async () => {
      cancelCount();
      if (!dialog.dataset.email) {
        status.textContent = "Email is awaiting Josh. See About / contact.";
        return;
      }
      try {
        await navigator.clipboard.writeText(dialog.dataset.email);
        status.textContent = "Email copied.";
      } catch {
        status.textContent = `Could not copy. Email: ${dialog.dataset.email}`;
      }
    });
</script>
<style>
  dialog {
    width: min(560px, calc(100% - 40px));
    max-height: 80dvh;
    padding: 0;
    border: 1px solid var(--line-2);
    border-radius: var(--r-lg);
    background: var(--surface);
    color: var(--ink);
    box-shadow: 0 24px 80px #0008;
  }
  dialog::backdrop {
    background: #0009;
    backdrop-filter: blur(4px);
  }
  .palette-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 20px;
    border-bottom: 1px solid var(--line);
  }
  h2 {
    font: 500 16px/1.6 var(--sans);
    margin: 0;
    letter-spacing: 0;
  }
  #command-search {
    display: block;
    width: calc(100% - 40px);
    margin: 16px 20px;
    min-height: 44px;
    font: 14px var(--mono);
  }
  .command-results {
    max-height: 45dvh;
    overflow: auto;
    padding: 0 12px 12px;
  }
  h3 {
    font: 500 12px/1.6 var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--mute);
    margin: 16px 8px 8px;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  li a,
  li button {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 44px;
    padding: 10px 12px;
    text-align: left;
    text-decoration: none;
    border: 0;
    border-radius: 6px;
    font: 14px var(--sans);
    background: transparent;
    color: var(--ink);
  }
  li a:hover,
  li button:hover,
  li a:focus-visible,
  li button:focus-visible {
    background: var(--raised);
  }
  li span {
    color: var(--dim);
    font-family: var(--mono);
    font-size: 12px;
  }
  #command-help {
    margin: 0;
    border-top: 1px solid var(--line);
    padding: 14px 20px;
    font: 11px var(--mono);
    color: var(--mute);
  }
  .empty {
    padding: 20px;
    color: var(--mute);
  }
  [hidden] {
    display: none !important;
  }
  @media print {
    dialog {
      display: none;
    }
  }
</style>
